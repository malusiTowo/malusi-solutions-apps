{
  "name": "malusi-solutions-apps",
  "private": true,
  "scripts": {
    "build": "vp run -r build",
    "dev": "vp run -r --parallel dev",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "format": "vp fmt --check",
    "format:fix": "vp fmt",
    "typecheck": "vp run -r --cache typecheck",
    "test": "vp test",
    "check": "vp check",
    "codegen": "vp run -r codegen",
    "clean": "vp run -r clean && git clean -xdf node_modules",
    "gen": "tsx tooling/generators/cli.ts",
    "factory": "tsx tooling/factory/src/cli.ts"
  },
  "devDependencies": {
    "@tooling/factory": "workspace:*",
    "tsx": "4.20.6",
    "typescript": "6.0.3",
    "vite-plus": "0.2.9"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.15.1"
}
