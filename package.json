{
  "name": "malusi-solutions-apps",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "codegen": "turbo run codegen",
    "clean": "turbo run clean && git clean -xdf node_modules",
    "gen": "turbo gen",
    "factory": "tsx tooling/factory/src/cli.ts"
  },
  "devDependencies": {
    "@tooling/factory": "workspace:*",
    "@turbo/gen": "2.10.4",
    "oxfmt": "0.58.0",
    "oxlint": "1.73.0",
    "tsx": "4.20.6",
    "turbo": "2.10.4",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.15.1"
}
