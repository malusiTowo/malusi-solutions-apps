# ─────────────────────────────────────────────────────────────
# Malusi Solutions monorepo — copy to .env and fill in.
# Single root .env is loaded by every workspace (turbo globalDependencies).
# ─────────────────────────────────────────────────────────────

# MongoDB Atlas
MONGODB_URI="mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB_NAME="habitual"

# Clerk (auth) — https://dashboard.clerk.com
CLERK_SECRET_KEY="sk_test_xxx"
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_xxx"
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_xxx"

# Stripe (payments)
STRIPE_SECRET_KEY="sk_test_xxx"
STRIPE_WEBHOOK_SECRET="whsec_xxx"

# Resend (email)
RESEND_API_KEY="re_xxx"

# Anthropic (AI engine)
ANTHROPIC_API_KEY="sk-ant-xxx"

# PostHog (analytics)
NEXT_PUBLIC_POSTHOG_KEY="phc_xxx"
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
EXPO_PUBLIC_POSTHOG_KEY="phc_xxx"
EXPO_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# Sentry (errors)
SENTRY_DSN="https://xxx@xxx.ingest.sentry.io/xxx"
NEXT_PUBLIC_SENTRY_DSN="https://xxx@xxx.ingest.sentry.io/xxx"
EXPO_PUBLIC_SENTRY_DSN="https://xxx@xxx.ingest.sentry.io/xxx"
SENTRY_AUTH_TOKEN=""

# Mobile → API base URL (Expo). Use your LAN IP for a physical device.
EXPO_PUBLIC_API_URL="http://localhost:3000"
