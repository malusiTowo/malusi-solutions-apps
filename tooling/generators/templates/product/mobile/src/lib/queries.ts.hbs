import { graphql } from "~/gql";

/**
 * Operations the app sends. `graphql()` is generated by `pnpm codegen` from
 * `@{{name}}/core`'s `schema.graphql`, so a document that does not match the schema
 * is a typecheck failure rather than a runtime one.
 */

export const HealthQuery = graphql(`
  query Health {
    health {
      ok
      service
    }
  }
`);
