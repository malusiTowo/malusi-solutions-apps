module.exports = (api) => {
  api.cache(true);
  return {
    presets: ["babel-preset-expo"],
    plugins: [
      // Routes live in src/app (matching tsconfig's `~/* -> ./src/*`), so the
      // Unistyles plugin must scan src, not a top-level app directory.
      ["react-native-unistyles/plugin", { root: "src" }],
      "react-native-worklets/plugin",
    ],
  };
};
