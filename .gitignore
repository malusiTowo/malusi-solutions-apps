# env
# Per-app .env files (apps/<product>/{api,mobile}/.env) are covered by these
# patterns too — gitignore matches at any depth. Secrets live in Infisical; run
# `pnpm factory sync <product>` to materialise them locally.
.env
.env.*
!.env.example
!.env.factory.example

# sentry
.sentryclirc

# logs / os
*.log
npm-debug.*
yarn-debug.*
yarn-error.*
.DS_Store

# editors
.idea/
.vscode/*
!.vscode/extensions.json

# testing
coverage/
