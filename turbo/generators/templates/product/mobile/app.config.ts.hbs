import type { ExpoConfig } from "expo/config";

/**
 * `extra.eas.projectId` and `updates.url` are filled in by `eas init`, which the
 * factory's `expo` driver runs. The Sentry plugin's org/project must match the
 * mobile project the `sentry` driver creates — hence the `-mobile-dev` suffix.
 */
const config: ExpoConfig = {
  name: "{{titleCase name}}",
  slug: "{{name}}",
  scheme: "{{name}}",
  version: "0.1.0",
  orientation: "portrait",
  userInterfaceStyle: "dark",
  runtimeVersion: { policy: "fingerprint" },
  updates: {
    // Set by `eas init`: https://u.expo.dev/<project-id>
  },
  ios: {
    bundleIdentifier: "com.malusisolutions.{{name}}",
    supportsTablet: true,
    infoPlist: { ITSAppUsesNonExemptEncryption: false },
  },
  android: {
    package: "com.malusisolutions.{{name}}",
  },
  plugins: [
    "expo-router",
    "expo-secure-store",
    "expo-updates",
    "expo-notifications",
    [
      "@sentry/react-native/expo",
      {
        organization: "malusi-solutions",
        project: "{{name}}-mobile-dev",
      },
    ],
  ],
  experiments: {
    // Kept off so `tsc` passes without a prebuild generating route types.
    typedRoutes: false,
  },
  extra: {
    eas: {
      // projectId is written here by `eas init`.
    },
  },
};

export default config;
