import { requireUserId } from "@repo/api";
import { Repository } from "@repo/db";
import { Effect } from "effect";
import { ITEMS_COLLECTION } from "../models";
import { protectedProcedure, publicProcedure, router, runEffect } from "./trpc";

interface ItemDoc {
  id: string;
  userId: string;
  title: string;
  createdAt: number;
}

export const appRouter = router({
  health: publicProcedure.query(({ ctx }) =>
    runEffect(ctx, Effect.succeed({ ok: true, service: "{{name}}", ts: Date.now() })),
  ),
  items: router({
    list: protectedProcedure.query(({ ctx }) =>
      runEffect(
        ctx,
        Effect.gen(function* () {
          const userId = yield* requireUserId;
          return yield* Repository.findMany<ItemDoc>(ITEMS_COLLECTION, { userId });
        }),
      ),
    ),
  }),
});

export type AppRouter = typeof appRouter;
