# ─────────────────────────────────────────────────────────────
# @habitual/api — server environment
#
# The real .env is written by `pnpm factory apply habitual` (or `pnpm factory sync
# habitual`) from Infisical. It is gitignored. Edit values in Infisical, not here.
#
# Names are deliberately NOT prefixed per product: each app reads its own .env, so
# DATABASE_URL means this product's database and nothing in packages/* has to know
# which product it is running inside.
# ─────────────────────────────────────────────────────────────

# Neon Postgres — created by the `neon` driver. The pooled URL is what the app
# uses; the unpooled one is for drizzle-kit DDL, which PgBouncer rejects.
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.eu-west-1.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:pass@ep-xxx.eu-west-1.aws.neon.tech/neondb?sslmode=require"
# Optional, comma-separated read replicas.
DATABASE_REPLICA_URLS=""

# Clerk — MANUAL, no create API. See .factory/manual-steps.md
CLERK_SECRET_KEY="sk_test_xxx"
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_xxx"

# Stripe — shared account; Product/Price/webhook created by the `stripe` driver
STRIPE_SECRET_KEY="sk_test_xxx"
STRIPE_WEBHOOK_SECRET="whsec_xxx"
STRIPE_PRICE_ID="price_xxx"

# Resend — created by the `resend` driver
RESEND_API_KEY="re_xxx"
RESEND_FROM="hello@habitual.malusi.solutions"

# Anthropic — workspace created by the driver, key is MANUAL (console only)
ANTHROPIC_API_KEY="sk-ant-xxx"

# Sent.dm — webhook endpoint created by the `sent` driver; the API key is the org
# key passed through. Set SENT_DM_SANDBOX=1 outside production to simulate sends.
SENT_DM_API_KEY=""
SENT_DM_WEBHOOK_SECRET="whsec_xxx"
SENT_DM_SANDBOX="1"

# PostHog — created by the `posthog` driver
NEXT_PUBLIC_POSTHOG_KEY="phc_xxx"
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# Sentry — created by the `sentry` driver
SENTRY_DSN="https://xxx@xxx.ingest.sentry.io/xxx"
NEXT_PUBLIC_SENTRY_DSN="https://xxx@xxx.ingest.sentry.io/xxx"
SENTRY_ORG="malusi-solutions"
SENTRY_PROJECT="habitual-web-dev"
# Only needed to upload source maps at build time.
SENTRY_AUTH_TOKEN=""

# Vercel — set by the `vercel` driver
NEXT_PUBLIC_APP_URL="http://localhost:3000"
