# ─────────────────────────────────────────────────────────────
# @habitual/mobile — Expo environment
#
# Written by `pnpm factory apply habitual` / `pnpm factory sync habitual` and
# gitignored. Only EXPO_PUBLIC_* reaches the app bundle — never put a server secret
# here, it ships to devices.
#
# The same values are pushed to EAS by the `expo` driver, so builds match local.
# ─────────────────────────────────────────────────────────────

# The deployed api. Use your LAN IP (not localhost) to test on a physical device.
EXPO_PUBLIC_API_URL="http://localhost:3000"

# Clerk — MANUAL, mirrored from the web publishable key
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_xxx"

# PostHog — created by the `posthog` driver
EXPO_PUBLIC_POSTHOG_KEY="phc_xxx"
EXPO_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# Sentry — created by the `sentry` driver (the mobile project, not the web one)
EXPO_PUBLIC_SENTRY_DSN="https://xxx@xxx.ingest.sentry.io/xxx"
