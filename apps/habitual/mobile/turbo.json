{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "codegen"],
      "env": [
        "EXPO_PUBLIC_API_URL",
        "EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY",
        "EXPO_PUBLIC_POSTHOG_KEY",
        "EXPO_PUBLIC_POSTHOG_HOST",
        "EXPO_PUBLIC_SENTRY_DSN"
      ],
      "inputs": ["$TURBO_DEFAULT$", ".env"],
      "outputs": ["expo-export/**"]
    }
  }
}
